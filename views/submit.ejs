<%- include('partials/header') %>

<div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow-md border border-gray-200">
    <h2 class="text-2xl font-bold mb-2 text-blue-900">Submit Your Innovation & Secure Credit</h2>
    <% if (questTitle) { %>
        <p class="text-xs bg-yellow-100 text-yellow-800 p-2 rounded mb-6 font-semibold">🎯 Solving Quest: <%= questTitle %></p>
    <% } else { %>
        <p class="text-sm text-gray-600 mb-6">Protect your intellectual property with an instant SHA-256 cryptographic timestamp.</p>
    <% } %>

    <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm"><%= error %></div>
    <% } %>

    <form action="/ideas/submit" method="POST" enctype="multipart/form-data" class="space-y-4">
        <% if (questId) { %>
            <input type="hidden" name="questId" value="<%= questId %>">
        <% } %>

        <div>
            <label class="block text-sm font-medium text-gray-700">Idea / Project Title</label>
            <input type="text" name="title" required class="mt-1 w-full px-3 py-2 border rounded-md focus:ring focus:ring-blue-300">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Detailed Description & Operational Benefits</label>
            <textarea name="description" rows="5" required class="mt-1 w-full px-3 py-2 border rounded-md focus:ring focus:ring-blue-300"></textarea>
        </div>

        <!-- ROI & Impact Metrics -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-lg border">
            <div>
                <label class="block text-xs font-semibold text-gray-700">Primary Impact Category</label>
                <select name="impactCategory" class="mt-1 w-full px-3 py-2 border rounded-md text-sm bg-white">
                    <option value="Cost Reduction">Cost Reduction</option>
                    <option value="Turnaround Time">Turnaround Time Optimization</option>
                    <option value="Fuel Efficiency">Fuel Efficiency</option>
                    <option value="Safety & Compliance">Safety & Compliance</option>
                    <option value="Passenger Experience">Passenger Experience</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700">Projected Annual Savings ($ USD)</label>
                <input type="number" step="0.01" name="projectedSavings" placeholder="e.g., 25000" class="mt-1 w-full px-3 py-2 border rounded-md text-sm bg-white">
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Co-Authors / Collaborators (Optional)</label>
            <input type="text" name="coauthorEmails" placeholder="colleague1@ethiopianairlines.com, colleague2@ethiopianairlines.com" class="mt-1 w-full px-3 py-2 border rounded-md text-sm">
            <p class="text-xs text-gray-500 mt-1">Separate multiple colleague emails with commas for joint certificate credit.</p>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Supporting Document / Prototype File (PDF, CAD, ZIP, Doc)</label>
            <input type="file" name="ideaFile" required class="mt-1 w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
        </div>

        <button type="submit" class="w-full bg-blue-900 text-white py-2.5 rounded-md font-semibold hover:bg-blue-800 transition shadow">
            Generate Secure Authorship Proof & Submit
        </button>
    </form>
</div>

<%- include('partials/footer') %>