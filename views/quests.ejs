<%- include('partials/header') %>

<div class="space-y-8">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-extrabold text-blue-900">🎯 Innovation Quests</h1>
            <p class="text-sm text-gray-600 mt-1">Direct operational challenges issued by department leadership. Solve high-priority problems.</p>
        </div>
    </div>

    <!-- Manager Quest Creation Form -->
    <% if (user && (user.role === 'Evaluator' || user.role === 'Admin')) { %>
        <div class="bg-blue-50 border border-blue-200 p-6 rounded-xl space-y-4">
            <h3 class="text-lg font-bold text-blue-900">📢 Post a New Innovation Quest</h3>
            <form action="/quests/create" method="POST" class="space-y-3">
                <div class="grid md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700">Quest Title / Problem Statement</label>
                        <input type="text" name="title" required placeholder="e.g., Optimizing Bole Airport Ground Handling turnaround" class="mt-1 w-full px-3 py-2 border rounded-md text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700">Target Department</label>
                        <select name="departmentId" required class="mt-1 w-full px-3 py-2 border rounded-md text-sm bg-white">
                            <% departments.forEach(dept => { %>
                                <option value="<%= dept.id %>"><%= dept.department_name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Detailed Quest Description & Objectives</label>
                    <textarea name="description" rows="3" required placeholder="Describe the current bottleneck, operational constraints, and desired outcomes..." class="mt-1 w-full px-3 py-2 border rounded-md text-sm"></textarea>
                </div>
                <button type="submit" class="bg-blue-900 text-white px-5 py-2 rounded-md font-semibold text-sm hover:bg-blue-800 transition">
                    Publish Quest
                </button>
            </form>
        </div>
    <% } %>

    <!-- Active Quests Grid -->
    <div class="grid gap-6 md:grid-cols-2">
        <% if (quests.length === 0) { %>
            <p class="text-gray-500 col-span-2 text-center py-12 bg-white rounded-xl border border-gray-200">No active Quests at the moment. Check back soon!</p>
        <% } else { %>
            <% quests.forEach(quest => { %>
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex justify-between items-start">
                            <span class="text-xs font-semibold px-2.5 py-1 bg-yellow-100 text-yellow-800 rounded-full">🎯 <%= quest.department_name %> Challenge</span>
                            <span class="text-xs font-medium text-gray-500"><%= new Date(quest.created_at).toLocaleDateString() %></span>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mt-3"><%= quest.title %></h3>
                        <p class="text-sm text-gray-600 mt-2"><%= quest.description %></p>
                    </div>

                    <div class="pt-4 border-t flex justify-between items-center text-xs">
                        <span class="text-gray-500">💡 <strong><%= quest.solution_count %></strong> Solutions Submitted</span>
                        <% if (user) { %>
                            <a href="/ideas/submit?questId=<%= quest.id %>" class="bg-blue-900 text-white px-4 py-1.5 rounded-md font-semibold hover:bg-blue-800 transition">
                                Solve Quest →
                            </a>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>