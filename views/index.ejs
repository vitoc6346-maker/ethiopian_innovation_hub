<%- include('partials/header') %>

<div class="space-y-10">
    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-blue-900 to-blue-800 text-white p-10 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center space-y-6 md:space-y-0">
        <div class="space-y-4 max-w-xl">
            <span class="bg-blue-700 text-blue-200 text-xs px-3 py-1 rounded-full uppercase tracking-wider font-semibold">Enterprise Innovation Hub</span>
            <h1 class="text-4xl font-extrabold tracking-tight">Empowering Ethiopian Airlines' Next Big Breakthrough</h1>
            <p class="text-blue-100 text-sm leading-relaxed">Securely submit, protect, and track your creative ideas and engineering solutions. Backed by immutable SHA-256 digital authorship certificates to guarantee absolute credit ownership.</p>
            <div class="pt-2 flex space-x-4">
                <% if (user) { %>
                    <a href="/ideas/submit" class="bg-white text-blue-900 px-6 py-2.5 rounded-lg font-bold hover:bg-blue-50 shadow transition text-sm">Submit an Idea</a>
                    <a href="/ideas/feed" class="border border-blue-300 text-white px-6 py-2.5 rounded-lg font-bold hover:bg-blue-800 transition text-sm">Explore Marketplace</a>
                <% } else { %>
                    <a href="/auth/register" class="bg-white text-blue-900 px-6 py-2.5 rounded-lg font-bold hover:bg-blue-50 shadow transition text-sm">Get Started</a>
                    <a href="/auth/login" class="border border-blue-300 text-white px-6 py-2.5 rounded-lg font-bold hover:bg-blue-800 transition text-sm">Sign In</a>
                <% } %>
            </div>
        </div>
        <div class="text-6xl bg-blue-800/50 p-8 rounded-full border border-blue-700 shadow-inner">
            ✈️
        </div>
    </div>

    <!-- Live Platform Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 text-center space-y-1">
            <p class="text-3xl font-extrabold text-blue-900"><%= stats.totalSubmissions %></p>
            <p class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Total Innovations Submitted</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 text-center space-y-1">
            <p class="text-3xl font-extrabold text-blue-900"><%= stats.totalUsers %></p>
            <p class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Registered Personnel</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 text-center space-y-1">
            <p class="text-3xl font-extrabold text-blue-900"><%= stats.totalDepartments %></p>
            <p class="text-xs uppercase tracking-wider text-gray-500 font-semibold">Active Airline Departments</p>
        </div>
    </div>

    <!-- Featured Top Voted Innovations -->
    <div class="space-y-4">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-bold text-blue-900">Trending Innovations</h2>
            <a href="/ideas/feed" class="text-sm font-semibold text-blue-600 hover:underline">View All Marketplace Feed →</a>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
            <% if (featuredIdeas.length === 0) { %>
                <p class="text-gray-500 col-span-3 text-center py-8 bg-white rounded-xl border border-gray-200">No submissions yet. Be the first innovator!</p>
            <% } else { %>
                <% featuredIdeas.forEach(sub => { %>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex flex-col justify-between space-y-4">
                        <div>
                            <span class="text-[11px] font-semibold px-2 py-0.5 bg-blue-100 text-blue-800 rounded-full"><%= sub.department_name %></span>
                            <h3 class="text-lg font-bold text-gray-900 mt-2"><%= sub.title %></h3>
                            <p class="text-xs text-gray-600 mt-1 line-clamp-2"><%= sub.description %></p>
                        </div>
                        <div class="pt-3 border-t flex justify-between items-center text-xs text-gray-500">
                            <span>By: <strong><%= sub.author_name %></strong></span>
                            <span class="bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded font-bold">👍 <%= sub.vote_count %> Votes</span>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>