<%- include('partials/header') %>

<div class="max-w-2xl mx-auto space-y-4">
    <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-200">
        <div>
            <h2 class="text-xl font-bold text-blue-900">Chat with <%= partner.full_name %></h2>
            <p class="text-xs text-gray-500"><%= partner.email %></p>
        </div>
        <a href="/messages" class="text-sm font-semibold text-blue-600 hover:underline">← Back to Inbox</a>
    </div>

    <!-- Message Bubble History -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 h-96 overflow-y-auto flex flex-col space-y-3">
        <% if (messages.length === 0) { %>
            <p class="text-gray-400 text-sm text-center my-auto">No messages exchanged yet. Say hello!</p>
        <% } else { %>
            <% messages.forEach(msg => { %>
                <div class="flex flex-col <%= msg.sender_id === user.id ? 'items-end' : 'items-start' %>">
                    <div class="max-w-xs md:max-w-md p-3 rounded-lg text-sm <%= msg.sender_id === user.id ? 'bg-blue-900 text-white rounded-br-none' : 'bg-gray-100 text-gray-900 rounded-bl-none' %>">
                        <p><%= msg.message_text %></p>
                    </div>
                    <span class="text-[10px] text-gray-400 mt-1"><%= new Date(msg.created_at).toLocaleTimeString() %></span>
                </div>
            <% }) %>
        <% } %>
    </div>

    <!-- Send Message Form -->
    <form action="/messages/send/<%= partner.id %>" method="POST" class="flex space-x-2">
        <input type="text" name="messageText" required placeholder="Type your message here..." class="flex-grow px-4 py-2.5 border rounded-lg text-sm focus:ring focus:ring-blue-300">
        <button type="submit" class="bg-blue-900 text-white px-6 py-2.5 rounded-lg text-sm font-semibold hover:bg-blue-800 transition shadow">
            Send
        </button>
    </form>
</div>

<%- include('partials/footer') %>